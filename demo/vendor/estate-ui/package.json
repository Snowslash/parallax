{
  "name": "@sangeev/estate-ui",
  "version": "2.0.0-alpha.7",
  "description": "Versioned visual contract for Sangeev's public web estate.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "files": [
    "src",
    "assets",
    "LICENSES",
    "LICENSE",
    "README.md",
    "DESIGN_CONTRACT.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./contract.css": "./src/contract.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=19 <20"
  },
  "devDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit:source": "node scripts/audit-estate.mjs",
    "audit:browser": "node scripts/browser-audit.mjs",
    "check": "npm test && npm run audit:source && npm run audit:browser",
    "release:check": "node scripts/check-all.mjs",
    "release:stage": "node scripts/stage-release.mjs",
    "pack:estate": "node scripts/pack-and-distribute.mjs"
  }
}
